# Local PostgreSQL defaults match docker-compose.yml. Replace all credentials for shared environments.
DATABASE_URL="postgresql://choice_fatigue:choice_fatigue_dev@localhost:5432/choice_fatigue?schema=public"

# Generate a unique random secret before deploying. Example: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:4173"

# Invite-only signup stays closed until this is explicitly configured.
BETA_INVITE_CODE=

# Local development only: explicitly opt in to printing password-reset links in the server terminal.
# Email is not needed for signup. Configure SMTP only if password-reset emails are desired.
AUTH_EMAIL_MODE=console
SMTP_URL=
SMTP_FROM=

# Required to save per-user media-service credentials. Generate with: openssl rand -base64 32
INTEGRATION_CREDENTIALS_KEY=

# Hosted deployments allow public HTTPS service addresses by default. Set true only when
# self-hosting and the app must reach private LAN services, such as http://192.168.x.x.
INTEGRATION_ALLOW_PRIVATE_NETWORKS=false

# Adult content stays disabled unless both this flag and the database setting are enabled.
ADULT_SECTION_ENABLED=false

# TMDB imports stay disabled until both settings are supplied.
# Confirm current usage, attribution, content-boundary, and retention requirements before enabling.
TMDB_API_READ_ACCESS_TOKEN=
TMDB_METADATA_ENABLED=false

# Adult metadata providers stay disabled unless the server Adult flag, admin setting,
# provider credential, and matching provider feature flag are all enabled.
THEPORNDB_API_TOKEN=
THEPORNDB_METADATA_ENABLED=false
STASHDB_API_KEY=
STASHDB_METADATA_ENABLED=false
