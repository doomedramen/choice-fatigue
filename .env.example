# PostgreSQL connection used by the app and Prisma commands.
DATABASE_URL="postgresql://choice_fatigue:choice_fatigue_dev@localhost:5432/choice_fatigue?schema=public"

# Core authentication service configuration.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:4173"

# Server-side key used to encrypt credentials saved through Admin.
# Generate 32 random bytes with: openssl rand -base64 32
INTEGRATION_CREDENTIALS_KEY=

# Set to 1 to disable media-service writes while retaining read-only checks.
INTEGRATIONS_READ_ONLY=0
