# Local PostgreSQL defaults match docker-compose.yml. Replace all credentials for shared environments.
DATABASE_URL="postgresql://choice_fatigue:choice_fatigue_dev@localhost:5432/choice_fatigue?schema=public"

# Generate a unique random secret before deploying. Example: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:4173"

# Invite-only signup stays closed until this is explicitly configured.
BETA_INVITE_CODE=

# Local development only: explicitly opt in to printing verification/reset links in the server terminal.
# For a shared deployment use AUTH_EMAIL_MODE=smtp and configure SMTP_URL and SMTP_FROM.
AUTH_EMAIL_MODE=console
SMTP_URL=
SMTP_FROM=

# Adult content stays disabled unless both this flag and the database setting are enabled.
ADULT_SECTION_ENABLED=false
