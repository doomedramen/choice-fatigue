{
  "name": "choice-fatigue",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 4173",
    "predev": "npm run db:generate",
    "build": "next build",
    "prebuild": "npm run db:generate",
    "start": "next start --hostname 0.0.0.0 --port 4173",
    "typecheck": "npm run db:generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:setup": "npm run db:generate && npm run db:migrate",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "admin:promote": "tsx scripts/promote-admin.ts",
    "preadmin:promote": "npm run db:generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "better-auth": "^1.7.14",
    "next": "^16.4.3",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "prisma": "^7.6.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
