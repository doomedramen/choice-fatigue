{
  "name": "choice-fatigue",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22 <27"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 4173",
    "predev": "prisma generate",
    "build": "next build",
    "prebuild": "prisma generate",
    "start": "next start --hostname 0.0.0.0 --port 4173",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "eval:replay": "tsx scripts/evaluate-recommendation-replay.ts",
    "test:ci": "pnpm test && pnpm typecheck && pnpm exec prisma validate && pnpm build && pnpm db:deploy:e2e && pnpm test:e2e",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:setup": "pnpm db:generate && pnpm db:migrate",
    "db:deploy": "prisma migrate deploy",
    "db:deploy:e2e": "prisma migrate deploy --config prisma.e2e.config.ts",
    "db:studio": "prisma studio",
    "integrations:rotate-key": "pnpm db:generate && tsx scripts/rotate-integration-key.ts",
    "admin:promote": "tsx scripts/promote-admin.ts",
    "preadmin:promote": "pnpm db:generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "better-auth": "^1.7.14",
    "next": "^16.4.3",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "lefthook": "2.2.2",
    "prisma": "^7.6.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
